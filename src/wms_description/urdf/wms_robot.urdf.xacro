<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wms_robot">

  <!-- ====================================================== -->
  <!-- ROBOT PARAMETERS                                       -->
  <!-- ====================================================== -->

  <!-- Body / payload values are still placeholders until we enter
       the measured production mass and centre of gravity. -->
  <xacro:property name="base_length" value="0.80"/>
  <xacro:property name="base_width" value="0.60"/>
  <xacro:property name="base_height" value="0.20"/>
  <xacro:property name="base_mass" value="50.0"/>

  <!-- Physical wheel locations estimated directly from the uploaded STL.
       Current mesh orientation is preserved because its Gazebo placement
       is already correct. In this frame the physical FRONT is -X. -->
  <xacro:property name="front_drive_radius" value="0.090"/>
  <xacro:property name="front_drive_width" value="0.060"/>
  <xacro:property name="front_drive_mass" value="4.0"/>
  <xacro:property name="front_drive_x" value="-0.4075"/>
  <xacro:property name="front_drive_y" value="0.0"/>
  <xacro:property name="front_drive_z" value="-0.1100"/>

  <xacro:property name="rear_support_radius" value="0.0762"/>
  <xacro:property name="rear_support_width" value="0.065"/>
  <xacro:property name="rear_support_mass" value="1.0"/>
  <xacro:property name="rear_support_x" value="0.4575"/>
  <xacro:property name="rear_support_y" value="0.33775"/>
  <xacro:property name="rear_support_z" value="-0.1238"/>

  <xacro:property name="lidar_mass" value="0.2"/>
  <xacro:property name="imu_mass" value="0.05"/>

  <!-- ====================================================== -->
  <!-- BASE FOOTPRINT                                         -->
  <!-- ====================================================== -->

  <link name="base_footprint"/>

  <!-- ====================================================== -->
  <!-- BASE LINK / REAL STL                                   -->
  <!-- ====================================================== -->

  <link name="base_link">
    <visual>
      <!-- Keep the transform that correctly places the uploaded STL. -->
      <origin xyz="-0.7205 0.5220 0.6405" rpy="3.14159265359 0 0"/>
      <geometry>
        <mesh filename="package://wms_description/meshes/wms_amr.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="amr_orange">
        <color rgba="1.0 0.35 0.0 1.0"/>
      </material>
    </visual>

    <!-- Keep a simple collision body for this step. We will fit the
         production collision footprint after the wheel model is verified. -->
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${base_mass}"/>
      <inertia
        ixx="1.67"
        ixy="0.0"
        ixz="0.0"
        iyy="2.83"
        iyz="0.0"
        izz="4.17"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- ====================================================== -->
  <!-- FRONT STEER / DRIVE MODULE                             -->
  <!-- Single powered wheel that steers around Z and rolls    -->
  <!-- around its axle. Visual is already contained in STL.   -->
  <!-- ====================================================== -->

  <link name="front_steering_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="front_steering_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_steering_link"/>
    <origin xyz="${front_drive_x} ${front_drive_y} ${front_drive_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.20" friction="0.05"/>
  </joint>

  <link name="front_drive_wheel_link">
    <collision>
      <geometry>
        <cylinder radius="${front_drive_radius}" length="${front_drive_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${front_drive_mass}"/>
      <inertia ixx="0.010" ixy="0.0" ixz="0.0"
               iyy="0.010" iyz="0.0" izz="0.010"/>
    </inertial>
  </link>

  <joint name="front_drive_wheel_joint" type="continuous">
    <parent link="front_steering_link"/>
    <child link="front_drive_wheel_link"/>
    <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <!-- ====================================================== -->
  <!-- REAR LEFT SUPPORT WHEEL                                -->
  <!-- Passive support wheel; visual is already in STL.       -->
  <!-- ====================================================== -->

  <link name="rear_left_support_wheel_link">
    <collision>
      <geometry>
        <cylinder radius="${rear_support_radius}" length="${rear_support_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${rear_support_mass}"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0"
               iyy="0.003" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="rear_left_support_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_support_wheel_link"/>
    <origin xyz="${rear_support_x} ${rear_support_y} ${rear_support_z}"
            rpy="1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <!-- ====================================================== -->
  <!-- REAR RIGHT SUPPORT WHEEL                               -->
  <!-- Passive support wheel; visual is already in STL.       -->
  <!-- ====================================================== -->

  <link name="rear_right_support_wheel_link">
    <collision>
      <geometry>
        <cylinder radius="${rear_support_radius}" length="${rear_support_width}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${rear_support_mass}"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0"
               iyy="0.003" iyz="0.0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="rear_right_support_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_support_wheel_link"/>
    <origin xyz="${rear_support_x} -${rear_support_y} ${rear_support_z}"
            rpy="1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <!-- ====================================================== -->
  <!-- LIDAR                                                  -->
  <!-- Invisible helper link; the STL already contains the    -->
  <!-- physical robot appearance.                             -->
  <!-- ====================================================== -->

  <link name="lidar_link">
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.20 0 0.75" rpy="0 0 0"/>
  </joint>
  <!-- <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.20 0 0.14" rpy="0 0 0"/>
  </joint> -->

  <!-- ====================================================== -->
  <!-- IMU                                                    -->
  <!-- Invisible helper link.                                 -->
  <!-- ====================================================== -->

  <link name="imu_link">
    <inertial>
      <mass value="${imu_mass}"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- ====================================================== -->
  <!-- GAZEBO DISPLAY MATERIAL                                -->
  <!-- ====================================================== -->

  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- ====================================================== -->
  <!-- GAZEBO JOINT STATE PUBLISHER                           -->
  <!-- ====================================================== -->

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_steering_joint</joint_name>
      <joint_name>front_drive_wheel_joint</joint_name>
      <joint_name>rear_left_support_wheel_joint</joint_name>
      <joint_name>rear_right_support_wheel_joint</joint_name>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>


  <!-- ====================================================== -->
  <!-- GAZEBO FRONT STEERING POSITION CONTROLLER              -->
  <!-- ====================================================== -->

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>front_steering_joint</joint_name>
      <topic>/front_steering_cmd</topic>
      <p_gain>80.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>4.0</d_gain>
      <cmd_max>300.0</cmd_max>
      <cmd_min>-300.0</cmd_min>
    </plugin>
  </gazebo>

  <!-- ====================================================== -->
  <!-- GAZEBO FRONT DRIVE VELOCITY CONTROLLER                 -->
  <!-- ====================================================== -->
  <gazebo>
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>front_drive_wheel_joint</joint_name>
      <topic>/front_drive_cmd</topic>
    </plugin>
  </gazebo>

  <!-- NOTE
       The old DiffDrive plugin has intentionally been removed.
       This robot is a single front steer-drive / tricycle layout,
       not a differential-drive robot. We will add the proper
       steering + traction controller in the next step. -->

  <!-- ====================================================== -->
  <!-- GAZEBO LIDAR SENSOR                                    -->
  <!-- ====================================================== -->

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.10</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ====================================================== -->
  <!-- GAZEBO IMU SENSOR                                      -->
  <!-- ====================================================== -->

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data</topic>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
